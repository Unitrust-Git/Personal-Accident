@model GPA.Models.PaymentProofViewVm

@{
    Layout = "_Layout";
    ViewData["Title"] = "Payment Proof Certificate";

    var previewUrl = Url.Action("ProofPdf", "Policy", new { reference = Model.Reference, download = false });
    var downloadUrl = Url.Action("ProofPdf", "Policy", new { reference = Model.Reference, download = true });
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h4 mb-0">Payment Proof Certificate</h1>
        <small class="text-muted">
            Reference: <strong>@Model.Reference</strong>
        </small>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="@previewUrl" target="_blank">
            <i class="bi bi-box-arrow-up-right me-1"></i> Open
        </a>

        <a class="btn btn-primary btn-sm" href="@downloadUrl">
            <i class="bi bi-download me-1"></i> Download
        </a>
    </div>
</div>

<div class="alert alert-warning d-flex align-items-start gap-2">
    <i class="bi bi-exclamation-triangle mt-1"></i>
    <div>
        <div class="fw-semibold">This is NOT a policy certificate.</div>
        <div class="small">
            It confirms payment only and is provided for support and reconciliation purposes.
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-transparent">
                <div class="fw-semibold">Supporting details</div>
                <div class="text-muted small">Use these when contacting support</div>
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-5 text-muted small">Amount</dt>
                    <dd class="col-7 fw-semibold">@Model.Amount.ToString("N2")</dd>

                    <dt class="col-5 text-muted small">Payment date</dt>
                    <dd class="col-7">@Model.PaymentDate.ToString("dd MMM yyyy, HH:mm")</dd>

                    <dt class="col-5 text-muted small">Payment type</dt>
                    <dd class="col-7 text-capitalize">@Model.PaymentType</dd>

                    <dt class="col-5 text-muted small">Transaction ref</dt>
                    <dd class="col-7"><span class="text-break">@Model.TransactionReference</span></dd>

                    @if (!string.IsNullOrWhiteSpace(Model.FailureReason))
                    {
                        <dt class="col-5 text-muted small">Failure reason</dt>
                        <dd class="col-7"><span class="text-break">@Model.FailureReason</span></dd>
                    }
                </dl>

                <hr />

                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-secondary"
                            onclick="navigator.clipboard.writeText('@Model.Reference')">
                        <i class="bi bi-clipboard me-1"></i> Copy Reference
                    </button>

                    <button type="button" class="btn btn-outline-secondary"
                            onclick="navigator.clipboard.writeText('@Model.TransactionReference')">
                        <i class="bi bi-clipboard me-1"></i> Copy Transaction Ref
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body p-2">
                <div id="pdfLoader" class="text-center py-3">
                    <div class="spinner-border text-primary"></div>
                    <div class="small mt-2">Loading PDF preview…</div>
                </div>

                <div style="height:80vh;">
                    <iframe src="@previewUrl"
                            title="Payment Proof PDF"
                            onload="document.getElementById('pdfLoader').style.display='none';"
                            sandbox="allow-same-origin allow-scripts"
                            referrerpolicy="no-referrer"
                            loading="lazy"
                            style="width:100%; height:100%; border:0;">
                    </iframe>
                </div>

                <div class="mt-2 text-muted small">
                    If the preview doesn’t show, use “Open” or “Download”.
                </div>
            </div>
        </div>
    </div>
</div>
