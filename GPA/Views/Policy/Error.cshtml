@{
    ViewData["Title"] = "We couldn't complete your request";
    var reason = (ViewBag.Reason as string) ?? "unknown";
    var reference = ViewBag.Reference as string;
    var amount = ViewBag.Amount;
    var txStatus = ViewBag.TransactionStatus as string;

    string title = "We couldn't complete your request";
    string message = "Something went wrong while processing your request.";

    switch (reason)
    {
        case "missing-reference":
            title = "Missing payment reference";
            message = "We couldn't find your payment reference. Please try again from the payment page.";
            break;

        case "not-found":
            title = "Payment not found";
            message = "We couldn't find a payment record for this reference. If you were charged, please contact support.";
            break;

        case "paymentfailed":
        case "failed":
            title = "Payment was not successful";
            message = "Your payment did not complete successfully. Please try again.";
            break;

        case "invalid-metadata":
            title = "Payment received, but we need assistance";
            message = "Your payment was received, but we couldn’t validate the payment details. Please contact support.";
            break;

        case "unknown":
        default:
            title = "We couldn't complete your request";
            message = "Please try again. If the issue persists, contact support.";
            break;
    }
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm" style="max-width: 620px; width: 100%;">
        <div class="card-body text-center p-4">
            <div class="mb-3" style="font-size: 3rem;">⚠️</div>

            <h4 class="mb-2">@title</h4>
            <p class="text-muted">@message</p>

            @if (!string.IsNullOrWhiteSpace(reference))
            {
                <div class="alert alert-light border mt-3 text-start">
                    <div><strong>Reference:</strong> @reference</div>
                    @if (amount != null)
                    {
                        <div><strong>Amount:</strong> @amount</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(txStatus))
                    {
                        <div><strong>Status:</strong> @txStatus</div>
                    }
                </div>
            }

            <div class="d-grid gap-2 mt-3">
                @if (!string.IsNullOrWhiteSpace(reference))
                {
                    <a class="btn btn-primary" href="/policy/invoicecallback?reference=@Uri.EscapeDataString(reference)">
                        Try again
                    </a>
                }
                <a class="btn btn-outline-secondary" href="/">
                    Go to homepage
                </a>
            </div>

            <p class="text-muted mt-3 mb-0" style="font-size: 0.9rem;">
                If you were charged and this continues, please contact support.
            </p>
        </div>
    </div>
</div>
