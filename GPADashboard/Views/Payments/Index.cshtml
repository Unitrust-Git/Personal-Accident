@model PaymentsIndexVm

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payments";
    ViewData["ActivePage"] = "Payments";
}


<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Payments</h4>
        <small class="text-muted">View and filter transactions</small>
    </div>

    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </a>
    </div>
</div>


<div class="card shadow-sm mb-3">
    <div class="card-body py-3">

        <form method="get" asp-action="Index" class="row g-2 align-items-end">

            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label small text-muted">Search</label>
                <input type="text"
                       class="form-control form-control-sm"
                       name="search"
                       value="@Model.Search"
                       placeholder="Reference or Invoice" />
            </div>

            <!-- Status -->
            <div class="col-md-2">
                <label class="form-label small text-muted">Status</label>
                <select name="status" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var s in Enum.GetValues(typeof(GPA.Core.Enums.PaymentStatus)))
                    {
                        var selected = Model.Status?.ToString() == s.ToString();
                        <option value="@s" selected="@(selected ? "selected" : null)">
                            @s
                        </option>
                    }
                </select>
            </div>

            <!-- From -->
            <div class="col-md-2">
                <label class="form-label small text-muted">From</label>
                <input type="date"
                       class="form-control form-control-sm"
                       name="from"
                       value="@(Model.From?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- To -->
            <div class="col-md-2">
                <label class="form-label small text-muted">To</label>
                <input type="date"
                       class="form-control form-control-sm"
                       name="to"
                       value="@(Model.To?.ToString("yyyy-MM-dd"))" />
            </div>

            <!-- Buttons -->
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    Reset
                </a>
            </div>

        </form>

    </div>
</div>


<table id="paymentsTable" class="table table-striped ptTable">
    <thead>
        <tr>
            <th>Reference</th>
            <th>Status</th>
            <th>TransactionId</th>
            <th class="text-end">Amount</th>
            <th class="text-end"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model.Items)
        {
            <tr>

                <td style="max-width:260px;">
                    <span class="d-inline-block text-truncate" style="max-width:260px;" title="@x.Reference">
                        @x.Reference
                    </span>
                </td>


                <td>
                    <span class="badge
                            @(x.Status.ToString() == "Successful" || x.Status.ToString() == "Success" || x.Status.ToString() == "Paid" ? "bg-success" :
                                                    x.Status.ToString() == "Failed" ? "bg-danger" :
                                                    x.Status.ToString() == "Pending" ? "bg-warning text-dark" :
                                                    "bg-secondary")">
                    @x.Status
                </span>
            </td>

                <td style="max-width:260px; word-break:break-all;">
                    @x.Id
                </td>

                <td class="text-end">
                    @x.Amount.ToString("N2")
                </td>

                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-controller="PolicyQueue"
                       asp-action="Index"
                       asp-route-paymentTransactionId="@x.Id">
                        Check Status
                    </a>

                    <button type="button"
                            class="btn btn-sm btn-primary js-payment-details"
                            data-id="@x.Id">
                        View
                    </button>
                </td>
            </tr>
                }
    </tbody>
</table>


@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">

            <!-- Previous -->
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-status="@Model.Status"
                   asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search">
                    Previous
                </a>
            </li>

            <!-- Page Numbers -->
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.PageSize"
                       asp-route-status="@Model.Status"
                       asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                       asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                       asp-route-search="@Model.Search">
                        @i
                    </a>
                </li>
            }

            <!-- Next -->
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-route-status="@Model.Status"
                   asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))"
                   asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))"
                   asp-route-search="@Model.Search">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}

<div class="modal fade" id="paymentDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Payment Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="paymentDetailsModalBody">
                <div class="text-muted">Loading...</div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $(document).on('click', '.js-payment-details', function () {
                const id = $(this).data('id');

                $('#paymentDetailsModalBody').html('<div class="text-muted">Loading...</div>');

                // Build URL to MVC action
                const url = '@Url.Action("DetailsModal", "Payments")' + '?id=' + encodeURIComponent(id);

                $('#paymentDetailsModalBody').load(url, function (response, status, xhr) {
                    if (status === "error") {
                        $('#paymentDetailsModalBody').html(
                            '<div class="alert alert-danger mb-0">Failed to load payment details.</div>'
                        );
                    }
                });

                const modalEl = document.getElementById('paymentDetailsModal');
                const modal = new bootstrap.Modal(modalEl);
                modal.show();
            });
        });
    </script>

    <script>


    </script>
}

