@model ProvisioningJobsIndexVm
@using GPA.Core.Models.Policy

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Policy Processing";
    ViewData["ActivePage"] = "Policy Processing";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">Policy Processing</h4>
        <small class="text-muted">Background policy creation and retries</small>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-dark border">
            Total: @Model.Result.TotalCount
        </span>

        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"
           asp-route-page="1"
           asp-route-pageSize="@Model.Result.PageSize"
           asp-route-status="@Model.Status"
           asp-route-paymentType="@Model.PaymentType"
           asp-route-paymentTransactionId="@Model.PaymentTransactionId"
           asp-route-search="@Model.Search">
            <i class="bi bi-arrow-clockwise me-1"></i> Refresh
        </a>
    </div>
</div>


<div class="card shadow-sm mb-3">
    <div class="card-body py-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">

            <div class="col-md-3">
                <label class="form-label small text-muted">Payment Transaction ID</label>
                <input type="text"
                       class="form-control form-control-sm"
                       name="paymentTransactionId"
                       value="@(Model.PaymentTransactionId?.ToString() ?? "")"
                       placeholder="GUID e.g. 9f7c...-...." />
            </div>


            <div class="col-md-3">
                <label class="form-label small text-muted">Search</label>
                <input type="text"
                       class="form-control form-control-sm"
                       name="search"
                       value="@Model.Search"
                       placeholder="Payment type or error..." />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm px-3">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">
                    Reset
                </a>
            </div>


        </form>
    </div>
</div>


<p>Total: @Model.Result.TotalCount</p>

<div class="card shadow-sm mb-3">
    <div class="card-body py-2">
        <div class="d-flex flex-wrap align-items-center gap-3 small">

            <strong class="me-2">Legend:</strong>

            <!-- Overall Status -->
            <span class="badge bg-success">Succeeded</span>
            <span class="badge bg-danger">Failed</span>
            <span class="badge bg-dark">Manual Review</span>
            <span class="badge bg-info">Processing</span>
            <span class="badge bg-warning text-dark">Pending</span>

            <span class="mx-2 text-muted">|</span>

            <!-- Step Flags -->
            <span class="badge bg-success">✔ Completed Step</span>
            <span class="badge bg-info">● Current Processing</span>
            <span class="badge bg-danger">✖ Failed Step</span>
            <span class="badge bg-secondary">○ Not Started</span>
        </div>
    </div>
</div>


<table id="jobsTable" class="table table-striped ptTable">
    <thead>
        <tr>
            <th>Status</th>
            <th>PaymentType</th>
            <th>Current Step</th>
            <th>Flags </th>
            <th>Attempts</th>
            <th>Next Retry (UTC)</th>
            <th>Updated (UTC)</th>
            <th>TxId</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var x in Model.Result.Items)
        {
            <tr>
                <td>
                    <span class="badge
                    @(x.OverallStatus == "Succeeded" ? "bg-success" :
                                    x.OverallStatus == "Failed" ? "bg-danger" :
                                    x.OverallStatus == "ManualReview" ? "bg-dark" :
                                    x.OverallStatus == "Processing" ? "bg-info" :
                                    "bg-warning text-dark")">
                        @x.OverallStatus
                    </span>

                    @if (!string.IsNullOrWhiteSpace(x.StepLastError))
                        {
                            <div class="small text-muted mt-1 text-truncate" style="max-width:260px;" title="@x.StepLastError">
                                @x.StepLastError
                            </div>
                        }
                    </td>


                <td>@x.PaymentType</td>

                <td>
                    <span class="badge bg-light text-dark border">
                        @x.CurrentStep
                    </span>
                </td>

                <td>
                    @{
                        bool allDone = x.OverallStatus == "Succeeded";

                        bool policyDone = allDone || x.CurrentStep != "Policy";
                        bool billingDone = allDone || (x.CurrentStep != "Policy" && x.CurrentStep != "Billing");
                        bool receiptDone = allDone || (x.CurrentStep != "Policy" && x.CurrentStep != "Billing" && x.CurrentStep != "Receipt");

                        string activeBadge =
                        x.OverallStatus == "Failed" ? "bg-danger" :
                        x.OverallStatus == "ManualReview" ? "bg-dark" :
                        x.OverallStatus == "Processing" ? "bg-info" :
                        "bg-warning";
                    }

                    <span class="badge @(policyDone ? "bg-success" : (x.CurrentStep == "Policy" ? activeBadge : "bg-secondary")) me-1">Policy</span>
                    <span class="badge @(billingDone ? "bg-success" : (x.CurrentStep == "Billing" ? activeBadge : "bg-secondary")) me-1">Billing</span>
                    <span class="badge @(receiptDone ? "bg-success" : (x.CurrentStep == "Receipt" ? activeBadge : "bg-secondary"))">Receipt</span>
                </td>


                <td>@x.TotalStepAttempts</td>

                <td>@(x.NextRetryAtUtc?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")</td>

                <td>@x.UpdatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>

                <td style="max-width:260px; word-break:break-all;">@x.PaymentTransactionId</td>



                <td class="text-end">
                    <form asp-controller="PolicyQueue" asp-action="Retry" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@x.Id" />

                        <button type="submit"
                                class="btn btn-sm btn-outline-warning"
                                @(x.OverallStatus == "Succeeded" ? "disabled" : null)>
                            Retry
                        </button>
                    </form>

                    <button type="button"
                            class="btn btn-sm btn-primary js-job-details"
                            data-id="@x.Id">
                        View
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>


@if (Model.Result.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">

            <li class="page-item @(Model.Result.Page == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Result.Page - 1)"
                   asp-route-pageSize="@Model.Result.PageSize"
                   asp-route-status="@Model.Status"
                   asp-route-paymentType="@Model.PaymentType"
                   asp-route-paymentTransactionId="@Model.PaymentTransactionId"
                   asp-route-search="@Model.Search">
                    Previous
                </a>
            </li>

            @for (int i = 1; i <= Model.Result.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Result.Page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-pageSize="@Model.Result.PageSize"
                       asp-route-status="@Model.Status"
                       asp-route-paymentType="@Model.PaymentType"
                       asp-route-paymentTransactionId="@Model.PaymentTransactionId"
                       asp-route-search="@Model.Search">
                        @i
                    </a>
                </li>
            }

            <li class="page-item @(Model.Result.Page == Model.Result.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(Model.Result.Page + 1)"
                   asp-route-pageSize="@Model.Result.PageSize"
                   asp-route-status="@Model.Status"
                   asp-route-paymentType="@Model.PaymentType"
                   asp-route-paymentTransactionId="@Model.PaymentTransactionId"
                   asp-route-search="@Model.Search">
                    Next
                </a>
            </li>

        </ul>
    </nav>
}


<div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Provisioning Job Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body" id="jobDetailsModalBody">
                <div class="text-muted">Loading...</div>
            </div>

            <div class="modal-footer">
                <small class="text-muted me-auto">Auto-refresh is ON (15s)</small>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $(document).on('click', '.js-job-details', function () {
                const id = $(this).data('id');
                $('#jobDetailsModalBody').html('<div class="text-muted">Loading...</div>');

                const url = '@Url.Action("DetailsModal", "PolicyQueue")' + '?id=' + encodeURIComponent(id);

                $('#jobDetailsModalBody').load(url, function (response, status, xhr) {
                    if (status === "error") {
                        $('#jobDetailsModalBody').html(
                            `<div class="alert alert-danger mb-0">
                                Failed to load details. Status: ${xhr.status}
                             </div>`
                        );
                    }
                });

                const modal = new bootstrap.Modal(document.getElementById('jobDetailsModal'));
                modal.show();
            });

            setInterval(function () {
                const modalEl = document.getElementById('jobDetailsModal');
                const isOpen = modalEl && modalEl.classList.contains('show');
                if (isOpen) return;

                window.location.reload();
            }, 15000);
        });
    </script>
}
