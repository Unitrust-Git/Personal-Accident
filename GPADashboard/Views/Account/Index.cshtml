@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Login";
}

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card shadow-sm p-4 text-center" style="width: 360px;">
        <div class="mb-4">
            <img src="~/img/New Unitrust Logo White 3.png"
                 alt="Unitrust Logo"
                 style="width: 180px; height: auto;" />
            <h5 class="mt-3 text-dark fw-bold">Sign In</h5>
        </div>

        <a type="submit" class="btn btn-primary w-100 fw-semibold" href="/Account/Login">Login with Azure AD</a>

    </div>
</div>